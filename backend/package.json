{
  "name": "hevronia-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test-only": "node --import tsx --test tests/*.test.ts",
    "test:memory-integration": "node --import tsx scripts/memory-integration.ts",
    "test:structured-output-integration": "node --import tsx scripts/structured-output-integration.ts",
    "conversations": "tsx scripts/conversations/index.ts"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@grammyjs/chat-members": "^1.2.0",
    "@langchain/core": "^1.2.5",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@langchain/openai": "^1.5.6",
    "better-sqlite3": "^13.0.3",
    "grammy": "^1.45.1",
    "langchain": "^1.5.5",
    "mem0ai": "^3.1.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}

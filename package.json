{
  "name": "hevronia",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Хевронія (@hevronia_bot) — a Telegram bot with persistent conversational memory",
  "workspaces": [
    "backend",
    "docs"
  ],
  "scripts": {
    "dev": "sh scripts/run-development-server",
    "build": "npm run build -w backend",
    "start": "npm run start -w backend",
    "typecheck": "tsc --noEmit",
    "static-analysis": "tsc --noEmit && eslint . --max-warnings 0",
    "test": "npm run test -w backend",
    "test-only": "npm run test-only -w backend",
    "test:memory-integration": "npm run test:memory-integration -w backend",
    "test:structured-output-integration": "npm run test:structured-output-integration -w backend",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "docs:dev": "npm run dev -w docs",
    "docs:build": "npm run build -w docs",
    "rules:test": "npm --prefix tools/eslint-plugin-hevronia run test",
    "rules:new": "node scripts/new-rule.mjs",
    "conversations": "npm run conversations -w backend --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-hevronia": "file:tools/eslint-plugin-hevronia",
    "eslint-plugin-import-x": "^4.14.22",
    "globals": "^17.7.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  }
}
